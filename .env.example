# Copiar a .env (manage.sh init lo hace automáticamente) y ajustar valores.

# OBLIGATORIO antes del primer "manage up": IP pública (Elastic IP) de la EC2, o IP LAN del PC en local.
# Es el endpoint que wg-easy escribe en la config de los clientes VPN y solo se aplica en su
# primer arranque: si se cambia después, hay que editarlo en el panel de wg-easy.
SERVER_PUBLIC_IP=

# --- Portainer (Fase 1) ---
PORTAINER_TAG=lts
PORTAINER_HTTPS_PORT=9443
PORTAINER_HTTP_PORT=9000

# --- Mosquitto ---
MQTT_PORT=1883

# --- Monitoreo (Fase 3) ---
# "-full" incluye el cliente de Prometheus (obligatorio para --export prometheus)
GLANCES_TAG=latest-full
PROMETHEUS_TAG=latest
# Publicado solo en 127.0.0.1 (consultar con túnel SSH)
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_TAG=latest
GRAFANA_PORT=3000
# URL exacta con la que se abre Grafana en el navegador.
# Codespaces: https://<CODESPACE_NAME>-3000.app.github.dev/   EC2: http://<IP>:3000/
GRAFANA_ROOT_URL=http://localhost:3000/

# --- VPN WireGuard (Fase 4) ---
# El endpoint que reciben los clientes es SERVER_PUBLIC_IP (en local: IP LAN del PC).
WG_EASY_TAG=15
WG_PORT=51820
# Panel web: publicado solo en 127.0.0.1
WG_UI_PORT=51821

# --- Samba (Fase 5) ---
# En Windows/local usar 1139 y 1445 (139/445 los ocupa el SMB de Windows)
SAMBA_NETBIOS_PORT=139
SAMBA_PORT=445